{
  "rules": {
    "users": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['displayName', 'email', 'createdAt'])",
        "displayName": { ".validate": "newData.isString() && newData.val().length > 0" },
        "email": { ".validate": "newData.isString() && newData.val().contains('@')" },
        "createdAt": { ".validate": "newData.isNumber()" }
      }
    },
    "messages": {
      "$conversationId": {
        ".read": "auth != null && $conversationId.contains(auth.uid)",
        ".write": "auth != null && $conversationId.contains(auth.uid)",
        ".indexOn": ["timestamp"],
        "$messageId": {
          ".validate": "newData.hasChildren(['senderId', 'text', 'timestamp'])",
          "senderId": { ".validate": "newData.val() === auth.uid" },
          "text": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 2000" },
          "timestamp": { ".validate": "newData.isNumber() && newData.val() <= now" }
        }
      }
    },
    "presence": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['online', 'lastSeen'])",
        "online": { ".validate": "newData.isBoolean()" },
        "lastSeen": { ".validate": "newData.isNumber()" }
      }
    },
    "typing": {
      "$conversationId": {
        ".read": "auth != null && $conversationId.contains(auth.uid)",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid && $conversationId.contains(auth.uid)",
          ".validate": "newData.isBoolean()"
        }
      }
    }
  }
}
